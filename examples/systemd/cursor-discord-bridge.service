[Unit]
Description=Cursor Discord bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/path/to/cursor-discord-channels
EnvironmentFile=/home/YOUR_USER/.cursor/channels/discord/.env
Environment=CURSOR_CWD=/path/to/your/project
Environment=CURSOR_MODEL=composer-2.5
ExecStart=/usr/bin/npm run bridge
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
