{
  "name": "cursor-discord-channels",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cursor + Discord MCP + headless bridge for always-on agents on your server",
  "scripts": {
    "bridge": "tsx bridge/daemon.ts",
    "mcp": "CDC_MCP_ONLY=1 tsx mcp/server.ts",
    "sync-mcp": "bash scripts/sync-discord-mcp.sh",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "discord.js": "^14.21.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
